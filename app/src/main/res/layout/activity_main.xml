<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SC803 自动热点"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="口袋阅2代 · 随身 4G 移动热点伴侣"
            android:textColor="@color/dark_gray"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp" />

        <!-- Hero Status Card (Big Central Card) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_border"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前运行状态"
                android:textColor="@color/dark_gray"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_hero_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="待机中 (极度省电)"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_hero_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="飞行模式 ON · 蓝牙待命 · 热点关闭"
                android:textColor="@color/dark_gray"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Master Auto Switch Button -->
        <Button
            android:id="@+id/btn_master_auto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="▶ 开启全自动控制"
            android:textColor="@color/black"
            android:background="@drawable/btn_border"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Target Devices Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_border"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="已授权的目标蓝牙设备"
                    android:textColor="@color/dark_gray"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_edit_devices"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="更改设备 ▾"
                    android:textColor="@color/black"
                    android:background="@drawable/btn_border"
                    android:textSize="11sp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_target_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="任意设备均触发 (未绑定)"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- System & Permissions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_border"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="系统服务与权限状态"
                android:textColor="@color/dark_gray"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Row 1: Accessibility -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="无障碍辅助 (免Root自动开关)"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_acc_action"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="● 已就绪"
                    android:textColor="@color/black"
                    android:background="@drawable/btn_border"
                    android:textSize="11sp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp" />

            <!-- Row 2: Hardware State -->
            <TextView
                android:id="@+id/tv_hw_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="蓝牙硬件: ON | 飞行模式: OFF"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <!-- Row 3: Sleep Hint -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 待机提示: 流程完成后自动切回本界面，系统按自然休眠时间灭屏或按电源键息屏"
                android:textColor="@color/dark_gray"
                android:textSize="10sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Advanced Testing Collapsible Area -->
        <TextView
            android:id="@+id/tv_toggle_advanced"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▼ 高级手动测试 (排查时展开)"
            android:textColor="@color/dark_gray"
            android:textSize="12sp"
            android:padding="6dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/layout_advanced_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_border"
            android:padding="10dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btn_test_airplane_off"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="退出飞行"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    android:background="@drawable/btn_border"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btn_test_airplane_on"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="进入飞行"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    android:background="@drawable/btn_border"
                    android:layout_marginStart="3dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_test_hotspot_on"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="开热点"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    android:background="@drawable/btn_border"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btn_test_hotspot_off"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="关热点"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    android:background="@drawable/btn_border"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btn_test_bt_on"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="开蓝牙"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    android:background="@drawable/btn_border"
                    android:layout_marginStart="2dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
