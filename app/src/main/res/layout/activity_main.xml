<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="6dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SC803 自动热点"
        android:textColor="@color/black"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_border"
        android:padding="6dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_automation_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="自动化状态: 待机中 (飞行ON+蓝牙ON)"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_target_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="目标设备: (未设置，监听任意连接)"
            android:textColor="@color/dark_gray"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_bt_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="蓝牙: 检测中..."
                android:textColor="@color/black"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_airplane_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="飞行模式: OFF"
                android:textColor="@color/black"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_accessibility_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="无障碍服务: 检测中..."
            android:textColor="@color/black"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Enable Accessibility Button (Shown if not enabled) -->
    <Button
        android:id="@+id/btn_open_accessibility"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:text="⚠️ 点击跳转开启系统无障碍服务"
        android:textColor="@color/white"
        android:background="@color/black"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Device Admin Button for Auto Screen Off -->
    <Button
        android:id="@+id/btn_device_admin"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:text="🔒 开启自动熄屏权限 (热点开启后自动息屏)"
        android:textColor="@color/black"
        android:background="@drawable/btn_border"
        android:textSize="11sp"
        android:layout_marginBottom="4dp" />

    <!-- Automation Controls Row: Toggle Auto Mode & Select Target Device -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btn_toggle_auto"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="自动控制: 已停止"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/btn_border"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btn_select_device"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="选择目标蓝牙"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:background="@drawable/btn_border"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <!-- Manual Testing Controls (Milestone 2) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="3dp">

        <Button
            android:id="@+id/btn_airplane_off"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="退出飞行"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:background="@drawable/btn_border"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btn_airplane_on"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="开启飞行"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:background="@drawable/btn_border"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btn_bluetooth_on"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="开启蓝牙"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:background="@drawable/btn_border"
            android:layout_marginStart="1dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btn_hotspot_on"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="开启 WLAN 热点"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/btn_border"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btn_hotspot_off"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="关闭 WLAN 热点"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:background="@drawable/btn_border"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <!-- Toolbar: Copy, Clear, Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="3dp">

        <Button
            android:id="@+id/btn_copy_logs"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:text="复制日志"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:background="@drawable/btn_border"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btn_clear_logs"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:text="清空"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:background="@drawable/btn_border"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:text="刷新"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:background="@drawable/btn_border"
            android:layout_marginStart="1dp" />
    </LinearLayout>

    <!-- Log Section Title -->
    <TextView
        android:id="@+id/tv_log_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="事件日志 (共 0 条):"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <!-- RecyclerView Log List Container with Border -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_border"
        android:padding="2dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_logs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />
    </FrameLayout>

</LinearLayout>
