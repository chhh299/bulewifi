<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="8dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SC803 自动热点 (M2: 无障碍控制)"
        android:textColor="@color/black"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Android 8.1 API 27 | 免Root 无障碍模拟点击"
        android:textColor="@color/dark_gray"
        android:textSize="11sp"
        android:layout_marginBottom="4dp" />

    <!-- Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_border"
        android:padding="6dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_bt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="蓝牙: 检测中..."
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/tv_accessibility_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="无障碍服务: 检测中..."
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/tv_service_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="前台探测服务: 运行中"
            android:textColor="@color/dark_gray"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Enable Accessibility Button (Shown if not enabled) -->
    <Button
        android:id="@+id/btn_open_accessibility"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="⚠️ 点击跳转开启系统无障碍服务"
        android:textColor="@color/white"
        android:background="@color/black"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- M2 Manual Controls Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="M2 手动无障碍控制测试:"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <!-- M2 Controls Row 1: Airplane OFF, Airplane ON, BT ON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btn_airplane_off"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="退出飞行"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_border"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btn_airplane_on"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="开启飞行"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_border"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btn_bluetooth_on"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="开启蓝牙"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:background="@drawable/btn_border"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <!-- M2 Controls Row 2: Hotspot ON, Hotspot OFF -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btn_hotspot_on"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="🔥 开启 WLAN 热点"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_border"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btn_hotspot_off"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="关闭 WLAN 热点"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:background="@drawable/btn_border"
            android:layout_marginStart="3dp" />
    </LinearLayout>

    <!-- Toolbar: Copy, Clear, Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btn_copy_logs"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="复制日志"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:background="@drawable/btn_border"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btn_clear_logs"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="清空"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:background="@drawable/btn_border"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="刷新状态"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:background="@drawable/btn_border"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <!-- Log Section Title -->
    <TextView
        android:id="@+id/tv_log_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="事件日志 (共 0 条):"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <!-- RecyclerView Log List Container with Border -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_border"
        android:padding="2dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_logs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />
    </FrameLayout>

</LinearLayout>
